{
	"$schema": "https://json.schemastore.org/umbraco-package.json",
	"id": "Umbraco.Community.BetterIcons",
	"name": "BetterIcons",
	"version": "1.1.0",
	"allowPublicAccess": true,
	"extensions": [
		{
			"type": "propertyEditorSchema",
			"alias": "BetterIcons.Editor",
			"name": "BetterIcons",
			"meta": {
				"defaultPropertyEditorUiAlias": "BetterIcons.UI",
				"settings": {
					"properties": [
						{
							"alias": "allowedCollections",
							"label": "Allowed Icon Libraries",
							"description": "Select which icon libraries should be available in the picker. If none are selected, all libraries will be shown.",
							"propertyEditorUiAlias": "Umb.PropertyEditorUi.CheckBoxList",
							"config": [
								{
									"alias": "items",
									"value": [
										{ "name": "Material Design Icons", "value": "mdi" },
										{ "name": "Phosphor", "value": "ph" },
										{ "name": "Tabler Icons", "value": "tabler" },
										{ "name": "Lucide", "value": "lucide" },
										{ "name": "Heroicons", "value": "heroicons" },
										{ "name": "Carbon", "value": "carbon" },
										{ "name": "Bootstrap Icons", "value": "bi" },
										{ "name": "Ionicons", "value": "ion" },
										{ "name": "Remix Icon", "value": "ri" },
										{ "name": "Font Awesome Solid", "value": "fa6-solid" },
										{ "name": "Font Awesome Regular", "value": "fa6-regular" },
										{ "name": "Font Awesome Brands", "value": "fa6-brands" },
										{ "name": "Simple Icons (Brands)", "value": "simple-icons" },
										{ "name": "SVG Logos", "value": "logos" },
										{ "name": "Skill Icons", "value": "skill-icons" },
										{ "name": "Devicon", "value": "devicon" },
										{ "name": "VSCode Icons", "value": "vscode-icons" },
										{ "name": "File Icons", "value": "file-icons" },
										{ "name": "Emoji One", "value": "emojione" },
										{ "name": "Noto Emoji", "value": "noto" },
										{ "name": "Twitter Emoji", "value": "twemoji" },
										{ "name": "Fluent Emoji", "value": "fluent-emoji" }
									]
								}
							]
						}
					]
				}
			}
		},
		{
			"type": "propertyEditorUi",
			"alias": "BetterIcons.UI",
			"name": "BetterIcons",
			"element": "/App_Plugins/BetterIcons/static/js/bettericons.U14.js",
			"elementName": "bettericons-picker",
			"meta": {
				"label": "BetterIcons",
				"propertyEditorSchemaAlias": "BetterIcons.Editor",
				"icon": "icon-picture",
				"group": "pickers"
			}
		},
		{
			"type": "dashboard",
			"alias": "BetterIcons.Management.Dashboard",
			"name": "BetterIcons Management",
			"element": "/App_Plugins/BetterIcons/static/js/dashboard.U14.js",
			"elementName": "bettericons-management-dashboard",
			"weight": 0,
			"meta": {
				"label": "BetterIcons Management",
				"pathname": "bettericons-management"
			},
			"conditions": [
				{
					"alias": "Umb.Condition.SectionAlias",
					"match": "Umb.Section.Settings"
				}
			]
		},
		{
			"type": "icons",
			"alias": "BetterIcons.RegisteredIcons",
			"name": "BetterIcons Registered Icons",
			"js": "/App_Plugins/BetterIcons/registered-icons/index.js"
		}
	]
}
